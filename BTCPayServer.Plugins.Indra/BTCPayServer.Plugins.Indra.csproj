<Project Sdk="Microsoft.NET.Sdk.Razor">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <!-- The plugin identifier, distinct from upstream's BTCPayServer.Plugins.Boltz -->
        <AssemblyName>BTCPayServer.Plugins.Indra</AssemblyName>
        <RootNamespace>BTCPayServer.Plugins.Indra</RootNamespace>
        <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    </PropertyGroup>

    <!-- Plugin specific properties -->
    <PropertyGroup>
        <Product>Indra</Product>
        <Description>Accept Lightning payments without running a node in a non-custodial way, swapped through Indra.</Description>
        <!-- The single source of the plugin version; the Makefile reads it from here -->
        <Version>2.5.1</Version>
    </PropertyGroup>

    <ItemDefinitionGroup>
        <ProjectReference>
            <!-- The test project builds BTCPay with static web assets on; building it a second
                 time with them off would delete files that build needs -->
            <Properties Condition="'$(IndraTestBuild)' != 'true'">StaticWebAssetsEnabled=false</Properties>
            <Private>false</Private>
            <ExcludeAssets>runtime;native;build;buildTransitive;contentFiles</ExcludeAssets>
        </ProjectReference>
    </ItemDefinitionGroup>


    <!-- Plugin development properties -->
    <PropertyGroup>
        <AddRazorSupportForMvc>true</AddRazorSupportForMvc>
        <PreserveCompilationContext>false</PreserveCompilationContext>
        <GenerateEmbeddedFilesManifest>true</GenerateEmbeddedFilesManifest>
        <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    </PropertyGroup>

    <ItemGroup>
        <AdditionalFiles Include="Views\**" />
    </ItemGroup>

    <!-- This will make sure that referencing BTCPayServer doesn't put any artifact in the published directory -->

    <ItemGroup>
        <ProjectReference Include="..\btcpayserver\BTCPayServer\BTCPayServer.csproj" />
        <EmbeddedResource Include="Resources\**" />
        <EmbeddedResource Include="../boltz-client-manifest.txt" LogicalName="boltz-client-manifest.txt" />
        <Protobuf Include="Protos\boltzrpc\boltzrpc.proto" GrpcServices="Client" />
        <Protobuf Include="Protos\boltzrpc\autoswaprpc\autoswaprpc.proto" ProtoRoot="Protos\boltzrpc" GrpcServices="Client" />
        <PackageReference Include="Google.Protobuf" Version="3.18.0" />
        <PackageReference Include="Grpc.AspNetCore" Version="2.32.0" />
        <PackageReference Include="Grpc.Net.Client" Version="2.52.0" />
        <PackageReference Include="Grpc.Tools" Version="2.40.0">
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
            <PrivateAssets>all</PrivateAssets>
        </PackageReference>
        <PackageReference Include="System.Text.Encodings.Web" Version="10.0.2" />
    </ItemGroup>

    <ItemGroup>
      <UpToDateCheckInput Remove="Views\Indra\LNPaymentMethodSetupTab.cshtml" />
    </ItemGroup>

    <ItemGroup>
      <Folder Include="Views\Indra\Setup\" />
    </ItemGroup>
</Project>
